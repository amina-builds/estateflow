# Copy this file to a new file named .env (same folder) and fill in the values.
# Never upload .env to GitHub (.gitignore already blocks it).

# Google Cloud Console > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=PASTE-YOUR-CLIENT-ID.apps.googleusercontent.com

# Only these Google emails can sign in (comma separated)
ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com

# Random secret, 32+ characters. Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# Supabase: Project Settings > API. Use the Project URL and the SECRET key (or legacy service_role key).
# This key is a master key: backend only, never in the frontend, never on GitHub.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_KEY=

# Websites allowed to call this API (add your Vercel link when deploying)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Used for activity times
TIMEZONE=Asia/Karachi
